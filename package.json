{
  "name": "open-jumps",
  "private": true,
  "version": "0.0.1",
  "description": "Open Jumps — browser show-jumping game for the Open Sports Barcelona kids",
  "type": "module",
  "workspaces": [
    "shared",
    "server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
